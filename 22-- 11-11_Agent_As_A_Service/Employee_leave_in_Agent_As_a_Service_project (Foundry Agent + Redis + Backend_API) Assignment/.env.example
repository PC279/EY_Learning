# Copy this file to .env and fill in your values. Never commit .env itself.

# Your Foundry project's endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Must match the agent's name in Foundry exactly
FOUNDRY_AGENT_NAME=EmployeeLeaveAgent

# Redis in Docker: laptop port 6380 -> container leave-redis, database 0
REDIS_URL=redis://localhost:6380/0

# Forget a session after this many seconds without messages (3600 = 1 hour)
SESSION_TTL_SECONDS=3600
