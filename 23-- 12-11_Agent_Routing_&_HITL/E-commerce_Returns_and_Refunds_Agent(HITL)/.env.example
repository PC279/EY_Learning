# Copy this file to .env and fill in real values. Never commit .env.

# Azure OpenAI key: Foundry portal > your project > API key
AZURE_OPENAI_API_KEY=<your-api-key>

# Azure OpenAI endpoint in v1 format: https://<resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/

# The DEPLOYMENT name (Foundry > Deployments > Name column), not the model family
AZURE_OPENAI_MODEL=<your-deployment-name>
