# 1. Make a copy of this file and name the copy exactly:  .env
# 2. Choose ONE provider: gemini, openai or anthropic
# 3. Paste the API key for that provider below (no quotes, no spaces)

#AI_PROVIDER=gemini

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=


GEMINI_API_KEY=paste-your-key-here
OPENAI_API_KEY=paste-your-key-here
ANTHROPIC_API_KEY=paste-your-key-here

AI_MODEL=

# Optional: leave blank to use the default model for your provider
# (gemini-flash-latest / gpt-5-mini / claude-haiku-5-5)

